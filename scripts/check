#!/bin/sh
# Everything CI checks, stopping at the first failure. Extra arguments go to pytest.
set -e
# macOS drops DYLD_* when starting /bin/sh; WeasyPrint needs Homebrew's Pango.
if [ "$(uname)" = Darwin ] && [ -d /opt/homebrew/lib ]; then
    export DYLD_FALLBACK_LIBRARY_PATH="${DYLD_FALLBACK_LIBRARY_PATH:-/opt/homebrew/lib}"
fi
uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run pytest "$@"
