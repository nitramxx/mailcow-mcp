# mailcow-mcp configuration
#
# The same image runs two containers: the app (`serve`) and the broker (`broker`).
# Each gets its own env file; the sections below say which variables belong where.
# A container refuses to start on a missing or invalid value and lists every problem.
#
# Generate each key and secret separately:
#   docker run --rm ghcr.io/nitramxx/mailcow-mcp generate-key
#
# Back up ENC_KEY and BROKER_SIGNING_KEY outside the server. Losing them disconnects every user.

###############################################################################
# app (`mailcow-mcp serve`): internet-facing, behind mailcow's nginx
###############################################################################

# mailcow (default): sign in with mailcow, app passwords created automatically.
# generic: password login against any IMAP/SMTP server; no broker, no mailcow-only tools.
MODE=mailcow

# Public URL of this server, without a path. Required.
PUBLIC_URL=https://mcp.mail.example.com

# --- mailcow mode only -------------------------------------------------------

# Public mailcow URL, used for the "Sign in with mailcow" redirect. Required in mailcow mode.
MAILCOW_URL=https://mail.example.com

# From mailcow → System → Configuration → Access → OAuth2 Apps.
# Redirect URI to enter there: <PUBLIC_URL>/oauth/mailcow/callback
MAILCOW_OAUTH_CLIENT_ID=
MAILCOW_OAUTH_CLIENT_SECRET=

# Internal URL of the broker. Never route it through nginx.
BROKER_URL=http://broker:8091

# Shared with the broker; at least 32 characters. Required in mailcow mode.
BROKER_SHARED_SECRET=

# --- mail servers ------------------------------------------------------------

# Security: ssl (implicit TLS) or starttls. Unencrypted connections are not supported.
IMAP_HOST=dovecot-mailcow
IMAP_PORT=993
IMAP_SECURITY=ssl

# SMTP always authenticates, even where Postfix would trust the container's IP.
SMTP_HOST=postfix-mailcow
SMTP_PORT=587
SMTP_SECURITY=starttls

# CardDAV base URL for find_contacts.
# mailcow mode: defaults to <MAILCOW_URL>/SOGo/dav/. generic mode: unset disables contacts.
CARDDAV_URL=

# Hostname the mail server certificates are verified against, even when connecting
# to internal container names. Required in mailcow mode (the mailcow hostname).
# generic mode: optional; unset verifies each server against the host it connects to.
TLS_SERVER_NAME=mail.example.com

# Only for testing. Never disable in production.
TLS_VERIFY=true

# Optional PEM file with a private CA to trust in addition to the system CAs.
TLS_CA_FILE=

# --- sign-in -----------------------------------------------------------------

# Also offer email + password login in mailcow mode. generic mode always uses it.
ALLOW_PASSWORD_LOGIN=false

# Comma-separated domains allowed to sign in. Empty = any mailbox on the server.
ALLOWED_DOMAINS=

# Encrypts stored app passwords and capability tokens. Required.
ENC_KEY=

# Networks of the reverse proxy (mailcow's nginx), comma-separated IPs or CIDRs.
# Only these may set X-Forwarded-For; rate limits use the real client IP. Required.
TRUSTED_PROXIES=172.22.1.0/24

# --- behaviour ---------------------------------------------------------------

# Folders are found by their SPECIAL-USE flag (\Sent, \Drafts, \Junk, \Trash), then by
# these names if set, then by common names (Sent, Sent Items, Spam, …).
FOLDER_SENT=
FOLDER_DRAFTS=
FOLDER_JUNK=
FOLDER_TRASH=

# Save sent mail to the Sent folder: always, never, or auto (skip only for servers that
# file sent mail themselves, e.g. Gmail).
SAVE_SENT=always

# Per-mailbox send limits.
SEND_LIMIT_HOUR=30
SEND_LIMIT_DAY=300

# Maximum total size of an outgoing message, attachments included (1–100).
MAX_MESSAGE_MB=15

# Shown on the consent page (max 100 characters).
INSTANCE_NAME=mailcow MCP

# Language of the login and consent pages: en or cs.
DEFAULT_LANGUAGE=en

# --- runtime (rarely changed) ------------------------------------------------

# Writable directory for the database and audit log (the image's volume).
DATA_DIR=/data

# Listening port. app default: 8090.
PORT=8090

###############################################################################
# broker (`mailcow-mcp broker`): internal only, no published port, no nginx route
###############################################################################

# Internal mailcow API URL; must be https.
MAILCOW_API_URL=https://nginx-mailcow
# TLS_SERVER_NAME and TLS_VERIFY apply to the broker as well (same meaning as above).

# mailcow's read-write API key (mailcow → System → Configuration → Access).
# mailcow has a single read-write key. Set "Allow API access from" to the broker's static IP,
# plus the IPs of any automation that already uses the key.
MAILCOW_API_KEY=

# Used to verify mailcow OAuth tokens. Default: <MAILCOW_API_URL>/oauth/profile
MAILCOW_OAUTH_PROFILE_URL=

# Same value as in the app's env file.
# BROKER_SHARED_SECRET=

# Signs capability tokens. Broker only; never give it to the app. Required.
BROKER_SIGNING_KEY=

# DATA_DIR as above. Listening port: broker default 8091.
# PORT=8091
