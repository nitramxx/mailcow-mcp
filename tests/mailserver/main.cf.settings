myhostname = mail.test
mydestination = localhost
mynetworks = 127.0.0.0/8
virtual_mailbox_domains = example.test
virtual_alias_maps = texthash:/etc/postfix/virtual_aliases
virtual_transport = lmtp:unix:private/dovecot-lmtp
transport_maps = texthash:/etc/postfix/transport
smtpd_tls_cert_file = /certs/server.crt
smtpd_tls_key_file = /certs/server.key
smtpd_tls_security_level = may
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sender_login_maps = texthash:/etc/postfix/sender_login
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, defer_unauth_destination
smtpd_peername_lookup = no
smtp_host_lookup = native
disable_dns_lookups = yes
maillog_file = /dev/stdout
compatibility_level = 3.6
