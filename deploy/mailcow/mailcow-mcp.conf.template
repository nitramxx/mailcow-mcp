# mailcow-mcp: reverse proxy for the MCP server. Goes into mailcow's data/conf/nginx/ (any *.conf
# there is included at http level). Only the app is routed here, never the broker.
#
# The upstream is resolved at request time (resolver + variable), so mailcow's nginx starts and
# keeps working when the mailcow-mcp containers are stopped (requests then get 502).
server {
    listen ${HTTPS_PORT} ssl;
${LISTEN_IPV6}
    http2 on;
    server_name ${MCP_HOSTNAME};

    ssl_certificate /etc/ssl/mail/cert.pem;
    ssl_certificate_key /etc/ssl/mail/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:mailcow_mcp_ssl:5m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $mailcow_mcp_upstream http://mailcow-mcp:8090;

    # From MAX_MESSAGE_MB in app.env (attachments travel base64-encoded in tool calls).
    client_max_body_size ${MAX_BODY_MB}m;

    location / {
        proxy_pass $mailcow_mcp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace, don't append: the app trusts this header from nginx only.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # Streamable HTTP uses server-sent events.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
