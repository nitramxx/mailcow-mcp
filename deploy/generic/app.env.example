# mailcow-mcp app, generic mode. Copy to app.env and fill in. See docs/configuration.md.
# MODE, PUBLIC_URL and TRUSTED_PROXIES are set in docker-compose.yml.

# Your mail server. Security: ssl (port 993/465) or starttls (143/587).
IMAP_HOST=imap.example.org
IMAP_PORT=993
IMAP_SECURITY=ssl
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls

# Only these domains may sign in (recommended). Empty: any account on the server.
ALLOWED_DOMAINS=example.org

# Generate with: docker run --rm ghcr.io/nitramxx/mailcow-mcp generate-key
# Back it up: losing it disconnects every user.
ENC_KEY=

# Optional: contacts for find_contacts.
CARDDAV_URL=

INSTANCE_NAME=Mail MCP
DEFAULT_LANGUAGE=en
